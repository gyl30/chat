+void Surface::ClearGlyph(int x, int y) {
+  const int offset = std::min(0, FastCellAt(x, y).span);
+  const int head = x + offset;
+  if (head < 0 || head >= dimx_) {
+    return;
+  }
+  const int span = std::clamp(FastCellAt(head, y).span, 1, dimx_ - head);
+  for (int at = head; at < head + span; ++at) {
+    auto& cell = FastCellAt(at, y);
+    if (at != head && cell.span != head - at) {
+      continue;
+    }
+    cell.character.clear();
+    cell.span = 0;
+  }
+}
+
+bool Surface::SetGlyph(int x, int y, std::string_view value, int columns) {
+  if (columns <= 0 || x < 0 || y < 0 || y >= dimy_ ||
+      columns > dimx_ - x || !stencil.Contain(x, y) ||
+      !stencil.Contain(x + columns - 1, y)) {
+    return false;
+  }
+  const std::string bytes(value);
+  for (int at = x; at < x + columns; ++at) {
+    ClearGlyph(at, y);
+  }
+  auto& head = FastCellAt(x, y);
+  head.character = bytes;
+  head.span = columns;
+  for (int offset = 1; offset < columns; ++offset) {
+    auto& cell = FastCellAt(x + offset, y);
+    cell.character.clear();
+    cell.span = -offset;
+  }
+  return true;
+}
+
+bool Surface::SetCell(int x, int y, const Cell& value, int columns) {
+  const Cell content = value;
+  if (!SetGlyph(x, y, content.character, columns)) {
+    return false;
+  }
+  for (int offset = 0; offset < columns; ++offset) {
+    auto& cell = FastCellAt(x + offset, y);
+    cell = content;
+    cell.character = offset == 0 ? content.character : "";
+    cell.span = offset == 0 ? columns : -offset;
+  }
+  return true;
+}
