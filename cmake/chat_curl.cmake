block()
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_STATIC_LIBS ON)
    set(BUILD_CURL_EXE OFF)
    set(BUILD_TESTING OFF)
    set(BUILD_EXAMPLES OFF)
    set(BUILD_LIBCURL_DOCS OFF)
    set(BUILD_MISC_DOCS OFF)
    set(CURL_DISABLE_INSTALL ON)
    set(CURL_ENABLE_EXPORT_TARGET OFF)
    set(CURL_ENABLE_SSL ON)
    set(CURL_USE_OPENSSL ON)
    set(ENABLE_ARES OFF)
    set(ENABLE_THREADED_RESOLVER ON)
    set(USE_NGHTTP2 OFF)
    set(USE_NGTCP2 OFF)
    set(USE_QUICHE OFF)
    set(USE_LIBIDN2 OFF)
    foreach(option IN ITEMS CURL_ZLIB CURL_BROTLI CURL_ZSTD CURL_USE_LIBPSL CURL_USE_LIBSSH2 CURL_USE_LIBSSH CURL_USE_GSSAPI)
        set(${option} OFF)
    endforeach()
    foreach(protocol IN ITEMS DICT FILE FTP GOPHER IMAP IPFS LDAP LDAPS MQTT POP3 RTSP SMB SMTP TELNET TFTP WEBSOCKETS)
        set(CURL_DISABLE_${protocol} ON)
    endforeach()
    # Keep AWS SigV4 and the response header API for S3.
    set(CURL_DISABLE_AWS OFF)
    set(CURL_DISABLE_HTTP_AUTH OFF)
    add_subdirectory(third/curl EXCLUDE_FROM_ALL)
endblock()
