/* Shared widget geometry and interaction states.
   Named color tokens read the selected JSON palette; RGB tokens also support alpha overlays.
   The selected daylight.qss / midnight.qss is appended to this sheet.
   The check indicator SVG is materialized with the same on_accent color as painted icons. */
QMainWindow {
            background: ${canvas};
        }
        QWidget {
            background: transparent;
            color: ${text};
            font-size: 14px;
        }
        QDialog {
            background: ${panel};
        }
        QToolTip {
            background: ${panel};
            color: ${text};
            border: 1px solid ${border_strong};
            padding: 4px 7px;
        }
        QAbstractItemView {
            background: ${panel};
            border: 0;
            outline: 0;
            alternate-background-color: ${canvas};
            selection-background-color: ${selected};
            selection-color: ${text};
            show-decoration-selected: 1;
        }
        QListWidget::item:hover:enabled:!selected, QTreeWidget::item:hover:enabled:!selected {
            background: ${canvas_hover};
        }
        QHeaderView::section {
            background: ${subtle};
            color: ${text};
            border: 0;
            border-bottom: 1px solid ${border};
            padding: 4px 8px;
        }
        QFileDialog QToolButton {
            background: transparent;
            color: ${text};
            border: 2px solid transparent;
            border-radius: 6px;
            padding: 2px;
        }
        QFileDialog QToolButton:hover {
            background: ${subtle};
        }
        QFileDialog QToolButton:pressed {
            background: ${selected};
        }
        QFileDialog QToolButton:focus {
            border-color: ${focus};
        }
        QMenu {
            background: ${panel};
            color: ${text};
            border: 1px solid ${border};
            border-radius: 8px;
            padding: 6px;
        }
        QMenu::item {
            padding: 8px 28px 8px 12px;
            border-radius: 4px;
        }
        QMenu::item:selected {
            background: ${selected};
            color: ${text};
        }
        QMenu::item:disabled {
            color: ${text_muted};
        }
        QMenu::separator {
            height: 1px;
            background: ${border};
            margin: 4px 8px;
        }
        QDialog#groupDialog QListWidget, QTabWidget::pane {
            background: transparent;
            border: 0;
        }
        QTabWidget#contactCategories::pane, QTabWidget#contactCategories > QStackedWidget,
        QTabWidget#contactCategories QTabBar, QListWidget#joinedGroupsList {
            background: ${panel};
            border: 0;
        }
        QTabBar::tab {
            background: transparent;
            color: ${text_secondary};
            border: 0;
            border-bottom: 2px solid transparent;
            padding: 8px 14px;
        }
        QTabBar::tab:selected {
            color: ${accent};
            border-bottom-color: ${accent};
        }
        QTabBar::tab:hover:!selected {
            background: ${canvas_hover};
        }
        QLabel#groupOverviewTitle {
            font-size: 22px;
            font-weight: 600;
            color: ${text};
        }
        QLabel#groupOverviewCount, QLabel#groupOverviewPinned, QLabel#groupOverviewInvite,
        QLabel#groupDetailHint, QLabel#groupJoinRequestsStatus, QLabel#groupStatus,
        QLabel#messageSearchStatus, QLabel#messageSearchHelp, QLabel#messageSearchCount, QLabel#attachmentStatus {
            font-size: 13px;
            color: ${text_secondary};
        }
        QLabel#groupSectionHeading {
            font-size: 13px;
            font-weight: 600;
            color: ${text_secondary};
        }
        QTextEdit, QPlainTextEdit {
            background: ${surface};
            border: 1px solid ${input_border};
            border-radius: 8px;
            padding: 6px;
        }
        QDialog QPushButton, QWidget#sidebarSearchPanel QPushButton, QToolButton#unpinMessageButton {
            min-height: 32px;
            padding: 0 12px;
            background: ${surface};
            color: ${text};
            border: 1px solid ${input_border};
            border-radius: 8px;
        }
        QDialog QPushButton:hover:enabled, QWidget#sidebarSearchPanel QPushButton:hover:enabled, QToolButton#unpinMessageButton:hover:enabled {
            background: ${canvas_hover};
        }
        QDialog QPushButton:pressed:enabled, QWidget#sidebarSearchPanel QPushButton:pressed:enabled, QToolButton#unpinMessageButton:pressed:enabled {
            background: ${selected};
        }
        QDialog QPushButton:focus, QWidget#sidebarSearchPanel QPushButton:focus, QToolButton#unpinMessageButton:focus {
            border-color: ${focus};
        }
        QDialog QPushButton:disabled, QWidget#sidebarSearchPanel QPushButton:disabled, QToolButton#unpinMessageButton:disabled {
            color: ${text_muted};
            border-color: ${border};
        }
        QListWidget#groupContactPicker, QListWidget#groupSelectedContacts, QListWidget#forwardTargets {
            background: transparent;
            border: 0;
            outline: 0;
        }
        QListWidget#groupContactPicker::item, QListWidget#forwardTargets::item {
            padding: 0 8px;
        }
        QListWidget#groupContactPicker::item:hover:!selected, QListWidget#forwardTargets::item:hover:!selected { background: ${canvas_hover}; }
        QListWidget#groupContactPicker::item:selected, QListWidget#forwardTargets::item:selected { background: ${selected}; color: ${text}; }
        QListWidget#groupContactPicker::indicator, QDialog#groupInviteDialog QListWidget::indicator {
            width: 16px;
            height: 16px;
            border: 1px solid ${border_strong};
            border-radius: 4px;
            background: ${surface};
        }
        QListWidget#groupContactPicker::indicator:checked, QDialog#groupInviteDialog QListWidget::indicator:checked {
            background: ${accent};
            border-color: ${accent};
            image: url("${check_icon}");
        }
        QListWidget#groupSelectedContacts::item {
            background: ${selected};
            color: ${text};
            border-radius: 8px;
            padding: 0 8px;
        }
        QDialog#confirmationDialog QPushButton#confirmationActionButton {
            background: ${danger};
            color: ${on_accent};
            border: 2px solid transparent;
        }
        QDialog#confirmationDialog QPushButton#confirmationActionButton:hover { background: ${danger_hover}; }
        QDialog#confirmationDialog QPushButton#confirmationActionButton:focus { border-color: ${danger_soft}; }
        QPushButton#groupReadAnnouncementButton, QPushButton#groupAllMembersButton, QPushButton#groupManageButton {
            border-color: transparent;
            background: transparent;
            color: ${link};
        }
        QPushButton#groupReadAnnouncementButton:focus, QPushButton#groupAllMembersButton:focus, QPushButton#groupManageButton:focus {
            border-color: ${focus};
        }
        QPushButton#groupLeaveButton:enabled, QPushButton#groupRevokeInviteButton:enabled, QPushButton#groupClearAnnouncementButton:enabled {
            color: ${danger};
        }
        QWidget#loginPage {
            background: transparent;
        }
        QWidget#windowFrame {
            background: ${canvas};
        }
        QWidget#windowFrame[login="true"] {
            background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                stop: 0 ${selected}, stop: 0.42 ${canvas}, stop: 1 ${canvas});
        }
        QWidget#windowTitleBar {
            background: ${chat_title_bar};
            border-bottom: 1px solid ${border};
        }
        QWidget#windowTitleBar[login="true"] {
            background: transparent;
            border-bottom: 0;
        }
        QLabel#windowTitle {
            color: ${text};
            font-size: 13px;
            font-weight: 600;
        }
        QWidget#windowTitleBar QToolButton {
            border: 0;
            border-radius: 0;
            background: transparent;
        }
        QWidget#windowTitleBar QToolButton:hover {
            background: rgba(${text.rgb}, 0.08);
        }
        QWidget#windowTitleBar QToolButton#windowCloseButton:hover {
            background: ${danger_soft};
        }
        QFrame#loginCard {
            background: transparent;
            border: 0;
        }
        QLabel#loginAvatar {
            border-radius: 44px;
            background: transparent;
        }
        QLabel#loginAvatar[empty="true"] {
            background: ${accent};
        }
        QFrame#loginCard QLineEdit {
            min-height: 42px;
            border-color: ${input_border};
            font-size: 15px;
        }
        QFrame#loginCard QLabel#subtleText, QDialog#registrationDialog QLabel#subtleText {
            color: ${text_secondary};
            font-size: 13px;
        }
        QLineEdit {
            min-height: 38px;
            padding: 0 12px;
            background: ${surface};
            border: 1px solid ${input_border};
            border-radius: 10px;
            selection-background-color: ${accent};
            selection-color: ${on_accent};
        }
        QFrame#loginCard QLineEdit:focus, QDialog#registrationDialog QLineEdit:focus {
            border-color: ${focus};
        }
        QPushButton#loginButton, QPushButton#registrationSubmitButton {
            min-height: 44px;
            border-radius: 10px;
        }
        QPushButton#registerButton, QPushButton#registrationCancelButton {
            min-height: 28px;
            background: transparent;
            color: ${accent};
            border: 2px solid transparent;
            border-radius: 8px;
        }
        QPushButton#registerButton:hover, QPushButton#registrationCancelButton:hover {
            background: ${subtle};
        }
        QPushButton#registerButton:pressed {
            background: ${selected};
            color: ${text};
        }
        QPushButton#registerButton:focus, QPushButton#registrationCancelButton:focus {
            border-color: ${focus};
        }
        QPushButton#registerButton:disabled, QPushButton#registrationCancelButton:disabled {
            color: ${text_muted};
        }
        QToolButton#serverSettingsButton {
            padding: 0;
            background: transparent;
            color: ${text_secondary};
            border: 2px solid transparent;
            border-radius: 8px;
            font-size: 13px;
        }
        QToolButton#serverSettingsButton:hover {
            background: ${subtle};
        }
        QToolButton#serverSettingsButton:checked, QToolButton#serverSettingsButton:pressed {
            background: ${selected};
        }
        QToolButton#serverSettingsButton:focus {
            border-color: ${focus};
        }
        QFrame#conversationPanel {
            background: ${chat_sidebar};
        }
        QFrame#conversationHeader {
            background: ${chat_sidebar};
            border-bottom: 1px solid ${border};
        }
        QFrame#chatPanel {
            background: ${canvas};
        }
        QLabel#subtleText {
            color: ${text_muted};
        }
        QLabel#sidebarNotice {
            margin: 0 12px 8px 12px;
            padding: 8px 12px;
            border-radius: 10px;
            background: ${subtle};
            color: ${accent};
            font-size: 13px;
        }
        QLabel#friendRequestsStatus, QLabel#friendRequestHeading {
            color: ${text_secondary};
            font-size: 13px;
        }
        QLabel#friendRequestHeading {
            font-weight: 600;
        }
        QFrame#chatHeader, QWidget#messageSelectionBar {
            background: ${panel};
            border-bottom: 1px solid ${border};
        }
        QPushButton#chatHeaderButton {
            padding: 0;
            border: 1px solid transparent;
            border-radius: 12px;
            background: transparent;
        }
        QPushButton#chatHeaderButton:hover:enabled {
            background: ${canvas_hover};
        }
        QPushButton#chatHeaderButton:disabled {
            color: ${text};
        }
        QLabel#chatHeaderName {
            font-size: 16px;
            font-weight: 600;
        }
        QLabel#chatHeaderStatus {
            font-size: 13px;
            color: ${text_secondary};
        }
        QPushButton#historyDownButton {
            background: ${surface};
            color: ${text};
            border: 1px solid ${input_border};
            border-radius: 18px;
            min-height: 34px;
            padding: 0 8px;
        }
        QPushButton#historyDownButton:hover:enabled {
            background: ${canvas_hover};
        }
        QPushButton#historyDownButton:focus {
            border: 1px solid ${focus};
        }
        QToolButton#connectionStatusButton {
            min-height: 26px;
            padding: 0 10px;
            border: 0;
            border-radius: 13px;
            background: ${canvas_hover};
            color: ${text_secondary};
            font-size: 12px;
            font-weight: 500;
        }
        QToolButton#connectionStatusButton:hover:enabled {
            background: ${subtle};
            color: ${accent};
        }
        QToolButton#connectionStatusButton:disabled {
            color: ${text_secondary};
        }
        QDialog#profileDialog {
            border: 1px solid ${border};
            border-radius: 12px;
        }
        QFrame#profileHeaderSection, QFrame#profileInfoSection {
            background: ${panel};
            border: 0;
        }
        QFrame#profileSectionSeparator {
            background: ${canvas_hover};
            border: 0;
        }
        QLabel#profileDialogAvatar {
            background: ${selected};
            color: ${accent};
            border-radius: 52px;
            font-size: 34px;
            font-weight: 700;
        }
        QLabel#profileDialogName {
            color: ${text};
            font-size: 22px;
            font-weight: 600;
        }
        QLabel#profileRelationship {
            color: ${text_secondary};
            font-size: 13px;
        }
        QLabel#mainMenuBadge {
            min-width: 16px;
            padding: 0 4px;
            border-radius: 8px;
            background: ${danger};
            color: ${on_accent};
            font-size: 11px;
            font-weight: 700;
        }
        QComboBox, QAbstractSpinBox {
            min-height: 34px;
            padding: 0 30px 0 10px;
            background: ${surface};
            color: ${text};
            border: 1px solid ${input_border};
            border-radius: 8px;
        }
        QComboBox::drop-down, QDateTimeEdit::drop-down {
            subcontrol-origin: padding;
            subcontrol-position: center right;
            width: 28px;
            border: 0;
            background: transparent;
        }
        QComboBox::down-arrow, QDateTimeEdit::down-arrow, QSpinBox::down-arrow {
            image: url("${chevron_icon}");
            width: 12px;
            height: 12px;
        }
        QSpinBox::up-button, QSpinBox::down-button {
            subcontrol-origin: padding;
            width: 24px;
            border: none;
            background: transparent;
        }
        QSpinBox::up-button { subcontrol-position: top right; }
        QSpinBox::down-button { subcontrol-position: bottom right; }
        QSpinBox::up-arrow { image: url("${up_icon}"); width: 12px; height: 12px; }
        QComboBox::drop-down:hover, QDateTimeEdit::drop-down:hover,
        QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: ${subtle}; }
        QComboBox:focus, QAbstractSpinBox:focus { border-color: ${focus}; }
        QComboBox:disabled, QAbstractSpinBox:disabled { color: ${text_muted}; background: ${canvas_hover}; }
        QComboBox QAbstractItemView, QCalendarWidget QAbstractItemView {
            background: ${surface};
            color: ${text};
            selection-background-color: ${accent};
            selection-color: ${on_accent};
        }
        QCalendarWidget QWidget#qt_calendar_navigationbar { background: ${subtle}; }
        QCalendarWidget QToolButton { color: ${text}; background: transparent; border: 0; padding: 3px 7px; }
        QCalendarWidget QToolButton:hover { background: ${selected}; }
        QCheckBox, QRadioButton { spacing: 8px; color: ${text}; }
        QCheckBox::indicator, QRadioButton::indicator {
            width: 16px; height: 16px; background: ${surface};
            border: 1px solid ${border_strong}; border-radius: 4px;
        }
        QCheckBox::indicator:checked { image: url("${check_icon}"); background: ${accent}; border-color: ${accent}; }
        QRadioButton::indicator { border-radius: 9px; }
        QRadioButton::indicator:checked { background: ${on_accent}; border: 5px solid ${accent}; width: 8px; height: 8px; }
        QCheckBox::indicator:focus, QRadioButton::indicator:focus { border-color: ${focus}; }
        QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: ${border}; }
        QToolButton#profileActionButton {
            padding: 0 12px;
            background: transparent;
            color: ${accent};
            border: 2px solid transparent;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
        }
        QToolButton#profileActionButton:hover {
            background: ${subtle};
        }
        QToolButton#profileActionButton:pressed {
            background: ${selected};
        }
        QToolButton#profileActionButton:focus {
            border-color: ${focus};
        }
        QDialog#profileDialog QPushButton {
            background: transparent;
            border: 2px solid transparent;
        }
        QDialog#profileDialog QPushButton#profileLogoutButton, QDialog#profileDialog QPushButton#removeContactButton,
        QDialog#profileDialog QPushButton#rejectFriendRequestButton, QDialog#profileDialog QPushButton#cancelFriendRequestButton {
            color: ${danger};
        }
        QDialog#profileDialog QPushButton:hover {
            background: ${subtle};
        }
        QDialog#profileDialog QPushButton:focus {
            border-color: ${focus};
        }
        QDialog#profileDialog QPushButton:disabled,
        QDialog#profileDialog QPushButton#profileLogoutButton:disabled, QDialog#profileDialog QPushButton#removeContactButton:disabled,
        QDialog#profileDialog QPushButton#rejectFriendRequestButton:disabled, QDialog#profileDialog QPushButton#cancelFriendRequestButton:disabled {
            color: ${text_muted};
        }
        QFrame#separator {
            background: ${canvas_hover};
            border: 0;
        }
        QListView#conversationList, QListView#userList, QListView#messageList, QListView#searchContextMessages, QListView#messageSearchResults,
        QListWidget#incomingFriendRequests, QListWidget#outgoingFriendRequests {
            border: 0;
            outline: 0;
            background: transparent;
        }
        QListView#conversationList, QListView#userList {
            padding: 0;
        }
        QListView#messageList, QListView#searchContextMessages, QListView#messageSearchResults {
            margin: 0;
            padding: 0;
            font-size: 18px;
        }
        QLabel#emptyConversationHint {
            background: rgba(${scrim.rgb}, 0.68);
            color: ${badge_text};
            border-radius: 18px;
            padding: 6px 14px;
            font-size: 16px;
            font-weight: bold;
        }
        QListView#searchContextMessages {
            background: ${canvas};
        }
        QScrollBar:vertical {
            width: 6px;
            margin: 6px 1px;
            background: transparent;
        }
        QScrollBar::handle {
            background: ${border_strong};
            border-radius: 3px;
        }
        QScrollBar::handle:vertical { min-height: 32px; }
        QScrollBar::handle:hover {
            background: ${input_hover};
        }
        QScrollBar::add-line, QScrollBar::sub-line {
            width: 0;
            height: 0;
            background: transparent;
        }
        QScrollBar::add-page, QScrollBar::sub-page {
            background: transparent;
        }
        QScrollBar:horizontal {
            height: 6px;
            margin: 1px 6px;
            background: transparent;
        }
        QScrollBar::handle:horizontal { min-width: 32px; }
        QFrame#inputBar, QWidget#replyBar, QLabel#groupSpeechNotice {
            background: ${panel};
            border-top: 1px solid ${border};
        }
        QLabel#groupSpeechNotice {
            padding: 4px 12px;
        }
        QPlainTextEdit#messageEdit, QPlainTextEdit#messageEdit:focus {
            font-family: "Noto Sans CJK SC", sans-serif;
            font-size: 16px;
            padding: 0;
            background: transparent;
            border: 0;
            border-radius: 0;
        }
        QToolButton#cancelReplyButton {
            border: 1px solid transparent;
            border-radius: 18px;
            background: transparent;
        }
        QToolButton#cancelReplyButton:hover {
            background: ${subtle};
        }
        QToolButton#cancelReplyButton:focus {
            border-color: ${focus};
        }
        QLineEdit[searchField="true"] {
            min-height: 36px;
            padding: 0 12px 0 6px;
            background: ${surface};
            border: 1px solid ${border};
            border-radius: 12px;
            font-size: 13px;
        }
        QLineEdit[searchField="true"]:hover:!focus {
            border-color: ${input_hover};
        }
        QLineEdit[searchField="true"]:focus {
            background: ${surface};
            border-color: rgba(${focus.rgb}, 0.65);
        }
        QToolButton#sendAttachmentButton,
        QToolButton#screenshotButton, QToolButton#emojiButton, QToolButton#chatHistoryButton {
            padding: 0;
            border: 0;
            border-radius: 18px;
            background: transparent;
        }
        QDialog#pollForm QToolButton#pollRemove {
            background: transparent;
            border: 1px solid transparent;
            border-radius: 5px;
            color: ${text_secondary};
            padding: 3px 6px;
        }
        QDialog#pollForm QToolButton#pollRemove:hover { color: ${danger}; background: ${danger_soft}; }
        QDialog#pollForm QToolButton#pollRemove:focus { border-color: ${focus}; }
        QWidget#pollResults { background: ${panel}; }
        QWidget#pollResults QPushButton {
            color: ${link};
            background: transparent;
            border: 1px solid transparent;
            border-radius: 6px;
            padding: 4px 8px;
        }
        QWidget#pollResults QPushButton:hover { background: ${subtle}; }
        QWidget#pollResults QPushButton:focus { border-color: ${focus}; }
        QWidget#pollResults QPushButton#pollVoter { color: ${text}; text-align: left; }
        QLabel#pollStatus, QLabel#pollTally { color: ${text_secondary}; }
        QLabel#pollQuestionHeading { font-weight: 600; font-size: 16px; }
        QLabel#pollGroup { font-weight: 600; }
        QToolButton#screenshotButton:hover:enabled, QToolButton#sendAttachmentButton:hover:enabled, QToolButton#emojiButton:hover:enabled,
        QToolButton#chatHistoryButton:hover:enabled {
            background: ${canvas_hover};
        }
        QFrame QToolButton[composeText="true"] {
            background: transparent;
            color: ${text};
            border: 1px solid transparent;
            border-radius: 6px;
            padding: 2px 1px;
        }
        QFrame QToolButton[composeText="true"]:hover:enabled {
            background: ${subtle};
        }
        QFrame QToolButton[composeText="true"]:checked, QFrame QToolButton[composeText="true"]:pressed:enabled {
            background: ${selected};
            border-color: ${accent};
        }
        QFrame#inputBar QToolButton:focus {
            border: 1px dashed ${focus};
        }
        QFrame QToolButton[composeText="true"]:disabled {
            color: ${text_muted};
        }
        QToolButton#mentionMemberButton::menu-indicator { image: none; }
        QFrame#emojiPicker {
            background: ${surface};
            border: 1px solid ${border};
            border-radius: 10px;
        }
        QToolButton#emojiChoice {
            border: 0;
            border-radius: 8px;
            background: transparent;
            font-family: "Noto Color Emoji";
            font-size: 22px;
        }
        QToolButton#emojiChoice:hover {
            background: ${canvas_hover};
        }
        QToolButton#sendButton {
            border: 1px solid transparent;
            border-radius: 18px;
            background: transparent;
        }
        QToolButton#sendButton:hover:enabled {
            background: ${canvas_hover};
        }
        QToolButton#sendButton:pressed:enabled {
            background: ${selected};
        }
        QListWidget#historyList {
            background: transparent;
        }
        QLabel#historyStatus {
            color: ${text_muted};
            padding: 24px 0;
        }

QLineEdit:hover:!focus, QTextEdit:hover:!focus, QPlainTextEdit:hover:!focus, QComboBox:hover:!focus { border-color: ${input_hover}; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border-color: ${focus}; }
QPushButton:pressed:enabled, QToolButton:pressed:enabled { background: ${selected}; }
QPushButton:focus, QToolButton:focus { border-color: ${focus}; }
QPushButton:disabled, QToolButton:disabled { color: ${text_muted}; }

QPushButton#chatHeaderButton:focus { border: 1px solid ${focus}; }
QLineEdit, QPlainTextEdit, QTextEdit { placeholder-text-color: ${text_muted}; }


/* Readable supporting identity and quiet, explicit contact guidance. */
QLabel#groupOverviewCount { font-size: 14px; }
QLabel#groupOverviewAnnouncement[empty="true"] { color: ${text_secondary}; font-size: 13px; }


/* Sidebar navigation uses the native menu beside search. */
QToolButton[navigationTool="true"] {
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: ${text_secondary};
}
QToolButton[navigationTool="true"]:hover { background: ${subtle}; }
QToolButton[navigationTool="true"]:pressed, QToolButton[navigationTool="true"]:open { background: ${selected}; }
QToolButton[navigationTool="true"]:focus { border-color: ${focus}; }
QToolButton[navigationTool="true"]::menu-indicator { image: none; width: 0; }
QToolButton#attachmentDownloadState, QToolButton#uploadRowActions {
    background: ${subtle}; color: ${text}; border: 1px solid ${border}; border-radius: 5px; padding: 3px 9px;
}
QToolButton#attachmentDownloadState:hover, QToolButton#uploadRowActions:hover { background: ${selected}; }
QMenu#mainNavigationMenu { min-width: 180px; }
QMenu#mainNavigationMenu::item:checked { background: ${subtle}; color: ${text}; }
QMenu#mainNavigationMenu::item:selected {
    background: ${selected};
    color: ${text};
}

/* Compact contact windows share the existing semantic palette. */
QLabel#dialogTitle { color: ${text}; font-size: 20px; font-weight: 700; }
QLabel#contactsStatus, QLabel#addUsersStatus { color: ${text_secondary}; font-size: 13px; }
QToolButton#contactsAddButton {
    background: ${surface}; color: ${text}; border: 1px solid ${input_border}; border-radius: 8px; padding: 0 10px;
}
QToolButton#contactsAddButton:hover {
    background: ${canvas_hover};
}
QToolButton#contactsAddButton:pressed {
    background: ${selected};
}
QToolButton#contactsAddButton:focus {
    border-color: ${focus};
}
/* The same primary role applies to actions in every dialog. */
QPushButton[primary="true"], QDialog#profileDialog QPushButton[primary="true"], QToolButton#profileActionButton[primary="true"] {
    background: ${accent}; color: ${on_accent}; border: 1px solid transparent; font-weight: 600;
}
QPushButton[primary="true"]:hover:enabled, QDialog#profileDialog QPushButton[primary="true"]:hover:enabled,
QToolButton#profileActionButton[primary="true"]:hover:enabled { background: ${accent_hover}; }
QPushButton[primary="true"]:pressed:enabled, QDialog#profileDialog QPushButton[primary="true"]:pressed:enabled,
QToolButton#profileActionButton[primary="true"]:pressed:enabled { background: ${accent_pressed}; }
QPushButton[primary="true"]:disabled, QDialog#profileDialog QPushButton[primary="true"]:disabled,
QToolButton#profileActionButton[primary="true"]:disabled { background: ${accent_disabled}; color: ${text_muted}; }
QPushButton[primary="true"]:focus, QDialog#profileDialog QPushButton[primary="true"]:focus,
QToolButton#profileActionButton[primary="true"]:focus { border-color: ${on_accent}; }

/* Settings uses the same compact dialog surfaces and focus language as Contacts. */
QDialog#settingsDialog {
    background: ${panel}; border: 1px solid ${border}; border-radius: 12px;
}
QDialog#settingsDialog QScrollArea, QStackedWidget#settingsPages {
    background: ${panel}; border: 0;
}
QWidget#settingsHomePage, QWidget#settingsNotificationsPage,
QWidget#settingsAppearanceChatPage, QWidget#settingsDesktopWindowPage { background: ${panel}; }
QLabel#settingsTitle { color: ${text}; font-size: 20px; font-weight: 600; }
QLabel#settingsAccountName { color: ${text}; font-size: 16px; font-weight: 600; }
QLabel#settingsAccountCaption, QLabel#settingsHint, QLabel#settingsTrayUnavailableHint {
    color: ${text_secondary}; font-size: 13px;
}
QLabel#settingsSectionHeading { color: ${text_secondary}; font-size: 14px; font-weight: 600; }
QToolButton#settingsAccountButton, QPushButton[settingsSection="true"] {
    background: transparent; color: ${text}; border: 1px solid transparent;
    border-radius: 8px; text-align: left;
}
QPushButton[settingsSection="true"] { padding: 8px 16px; font-size: 15px; }
QToolButton#settingsAccountButton:hover, QPushButton[settingsSection="true"]:hover { background: ${subtle}; }
QToolButton#settingsAccountButton:pressed, QPushButton[settingsSection="true"]:pressed { background: ${selected}; }
QToolButton#settingsAccountButton:focus, QPushButton[settingsSection="true"]:focus { border-color: ${focus}; }
QDialog#profileDialog QPushButton#profileLogoutButton, QPushButton#settingsLogoutButton {
    background: transparent; color: ${danger}; border: 1px solid transparent;
    border-radius: 8px; text-align: left; padding: 8px 16px;
}
QPushButton#settingsLogoutButton:hover, QPushButton#settingsLogoutButton:pressed { background: ${danger_soft}; }
QPushButton#settingsLogoutButton:focus { border-color: ${danger}; }
QDialog#settingsDialog QCheckBox {
    color: ${text}; font-size: 14px; spacing: 12px; padding: 10px 6px;
    border: 1px solid transparent; border-radius: 6px;
}
QDialog#settingsDialog QCheckBox:hover:enabled { background: ${subtle}; }
QDialog#settingsDialog QCheckBox:focus { border-color: ${focus}; }
QDialog#settingsDialog QCheckBox:disabled { color: ${text_muted}; }
QLabel#settingsSectionLabel { color: ${text}; font-size: 15px; }


/* Friend requests share the contacts row rhythm and existing semantic colors. */
QPushButton#contactsRequestsButton {
    background: transparent; border: 1px solid transparent; border-radius: 0;
    padding: 0; min-height: 54px; text-align: left;
}
QPushButton#contactsRequestsButton:hover { background: ${canvas_hover}; }
QPushButton#contactsRequestsButton:pressed { background: ${selected}; }
QPushButton#contactsRequestsButton:focus { border-color: ${focus}; }
QPushButton#contactsRequestsButton QLabel { background: transparent; border: none; }
QPushButton#contactsRequestsButton QLabel#contactsRequestsIcon { background: ${subtle}; border-radius: 20px; }
QLabel#contactsRequestsTitle { color: ${text}; font-size: 14px; font-weight: 600; }
QLabel#contactsRequestsSummary { color: ${text_secondary}; font-size: 13px; }
QPushButton#contactsRequestsButton QLabel#contactsRequestsBadge {
    background: ${danger}; color: ${on_accent};
    min-width: 18px; max-height: 20px; padding: 0 4px;
    border-radius: 10px; font-size: 12px; font-weight: 600;
}
QLabel#contactsRequestFeedback {
    margin: 4px 12px 8px 12px; padding: 8px 12px;
    background: ${subtle}; color: ${text_secondary}; border-radius: 8px; font-size: 13px;
}
QDialog#contactsDialog QPushButton#friendRequestRejectButton,
QDialog#contactsDialog QPushButton#friendRequestCancelButton { color: ${danger}; }
QDialog#contactsDialog QPushButton#friendRequestRejectButton:hover:enabled,
QDialog#contactsDialog QPushButton#friendRequestCancelButton:hover:enabled { background: ${subtle}; }
QDialog#contactsDialog QPushButton#friendRequestRejectButton:pressed:enabled,
QDialog#contactsDialog QPushButton#friendRequestCancelButton:pressed:enabled { background: ${selected}; }
QDialog#contactsDialog QPushButton#friendRequestRejectButton:focus,
QDialog#contactsDialog QPushButton#friendRequestCancelButton:focus { border-color: ${focus}; }
QDialog#contactsDialog QPushButton#friendRequestRejectButton:disabled,
QDialog#contactsDialog QPushButton#friendRequestCancelButton:disabled { color: ${text_muted}; }

QLabel#snapshotAuthor { color: ${message_sender}; font-weight: bold; }
QLabel#snapshotTime { color: ${text_secondary}; font-size: 12px; }
QTextBrowser#snapshotBody { background: transparent; border: 0; padding: 0; }

QLabel#pollFeedback { color: ${text_secondary}; }

QDialog[chatPopup="true"] {
    background: ${panel}; border: 1px solid ${border}; border-radius: 12px;
}
QToolButton#popupCloseButton, QToolButton#profileCloseButton, QToolButton#settingsCloseButton, QToolButton#settingsBackButton {
    background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 0;
}
QToolButton#popupCloseButton:hover, QToolButton#profileCloseButton:hover, QToolButton#settingsCloseButton:hover, QToolButton#settingsBackButton:hover {
    background: ${canvas_hover};
}
QToolButton#popupCloseButton:pressed, QToolButton#profileCloseButton:pressed,
QToolButton#settingsCloseButton:pressed, QToolButton#settingsBackButton:pressed {
    background: ${selected};
}
QToolButton#popupCloseButton:focus, QToolButton#profileCloseButton:focus, QToolButton#settingsCloseButton:focus, QToolButton#settingsBackButton:focus {
    border-color: ${focus};
}

QPushButton[forwardMode="true"]:checked {
    background: ${selected};
    color: ${text};
    border: 1px solid ${focus};
}

QToolButton[backgroundPreview="true"] {
    padding: 4px;
    border: 2px solid ${border};
    border-radius: 8px;
}
QToolButton[backgroundPreview="true"]:hover {
    background: ${canvas_hover};
}
QToolButton[backgroundPreview="true"]:checked {
    border-color: ${accent};
    color: ${link};
    font-weight: 600;
}
QToolButton[backgroundPreview="true"]:focus {
    background: ${selected};
}
