+void Canvas::ClearGlyph(int x, int y) {
+  const auto old = GetCell(x, y);
+  const int head = x + std::min(0, old.span);
+  if (head < 0 || head >= (width_ + 1) / 2) {
+    return;
+  }
+  const int columns = std::clamp(GetCell(head, y).span, 1, (width_ + 1) / 2 - head);
+  for (int at = head; at < head + columns; ++at) {
+    auto& cell = storage_[XY{at, y}];
+    if (at != head && cell.content.span != head - at) {
+      continue;
+    }
+    cell.content.character.clear();
+    cell.content.span = 0;
+    cell.type = CellType::kCell;
+  }
+}
